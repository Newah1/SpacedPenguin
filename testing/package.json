{
  "name": "spaced-penguin-testing",
  "version": "1.0.0",
  "description": "Offline level testing suite for Spaced Penguin",
  "main": "levelTester.js",
  "type": "module",
  "scripts": {
    "test": "node --test runtimeStability.test.js levelValidation.test.js",
    "validate-level": "node levelTester.js --validate-only --level",
    "test-level": "node levelTester.js --level",
    "test:cli": "node levelTester.js --single --level simple_test.json --angle 0 --power 300"
  },
  "keywords": ["game", "testing", "physics", "simulation"],
