{
  "name": "spaced-penguin-rewrite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "serve": "node testing/staticServer.js",
    "serve:levels": "node server/index.js",
    "serve:community": "node server/local.js",
    "test": "npm run test:unit && npm run test:server && npm run test:policy && npm run test:levels && npm run test:original-levels && npm run test:syntax && npm run test:e2e",
    "test:unit": "node --test testing/*.test.js",
    "test:server": "node --test server/testing/cors.test.js server/testing/router.test.js server/testing/server.test.js server/testing/realReplay.test.js",
    "test:policy": "node --test testing/configurationPolicy.test.js",
    "test:levels": "node testing/validateLevels.js",
    "test:original-levels": "node testing/verifyOriginalLevelPorts.js",
    "test:syntax": "node testing/checkSyntax.js",
    "generate:domain": "node tools/generateDomainContracts.js",
    "check:domain": "node tools/generateDomainContracts.js --check",
    "benchmark:gravity-sculpt-mass": "node testing/benchmarkGravitySculptMass.js",
    "build:simulator-wasm": "npm run generate:domain && node testing/buildWasmSimulator.js",
    "build:simulator-native": "npm run generate:domain && node testing/buildNativeSimulator.js",
    "headless:native": "node testing/nativeHeadlessCli.js",
    "benchmark:simulator-wasm": "node testing/benchmarkWasmSimulator.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
